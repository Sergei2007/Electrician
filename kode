        def make_update_func(var, lbl, prc):
            return lambda *args: update_row_cost(var, lbl, prc)

        # Привязываем обновление к изменению текста
        update_func = make_update_func(quantity_var, cost_label, price)
        quantity_var.trace('w', update_func)

        # Сохраняем ссылки
        calculator_entries[tab_name].append(quantity_entry)
        cost_labels[tab_name].append(cost_label)

    return content_frame


# Функции для создания сметы в Word
def create_estimate_docx():
    """Создать документ Word со сметой"""
    if not HAS_DOCX:
        messagebox.showerror("Ошибка", "Библиотека python-docx не установлена.\nУстановите: pip install python-docx")
        return

    if not selected_services:
        messagebox.showwarning("Предупреждение", "Нет выбранных услуг для создания сметы")
        return

    # Спросим информацию о проекте
    ask_project_info()

    # Если пользователь отменил ввод информации
    if not project_name:
        return

    # Спросим куда сохранить
    file_path = filedialog.asksaveasfilename(
        defaultextension=".docx",
        filetypes=[("Word документы", "*.docx"), ("Все файлы", "*.*")],
        initialfile=f"Смета_{project_name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.docx"
    )

    if not file_path:
        return

    try:
        # Создаем документ
        doc = Document()

        # Настройки страницы
        section = doc.sections[0]
        section.left_margin = Inches(0.5)
        section.right_margin = Inches(0.5)
        section.top_margin = Inches(0.5)
        section.bottom_margin = Inches(0.5)

        # Заголовок
        title = doc.add_heading('СМЕТА НА ЭЛЕКТРОМОНТАЖНЫЕ РАБОТЫ', 0)
        title.alignment = WD_ALIGN_PARAGRAPH.CENTER

        # Информация о проекте
        doc.add_paragraph(f"Название проекта: {project_name}")
        doc.add_paragraph(f"Заказчик: {customer_name}")
        doc.add_paragraph(f"Адрес объекта: {project_address}")
        doc.add_paragraph(f"Дата составления: {datetime.now().strftime('%d.%m.%Y')}")
        doc.add_paragraph("")

        # Таблица с услугами
        table = doc.add_table(rows=1, cols=6)
        table.style = 'Light Grid Accent 1'

        # Заголовки таблицы
        hdr_cells = table.rows[0].cells
        headers = ['№', 'Наименование работ', 'Ед. изм.', 'Кол-во', 'Цена за ед., руб.', 'Стоимость, руб.']

        for i, header in enumerate(headers):
            hdr_cells[i].text = header
            hdr_cells[i].paragraphs[0].runs[0].bold = True

        # Заполняем таблицу данными
        total_sum = 0
        row_num = 1

        # Группируем услуги по категориям
        services_by_category = {}
        for service in selected_services:
            category = service['tab']
            if category not in services_by_category:
                services_by_category[category] = []
            services_by_category[category].append(service)

        # Добавляем услуги в таблицу
        for category, services in services_by_category.items():
            # Заголовок категории
            row_cells = table.add_row().cells
            row_cells[1].text = f"--- {category.upper()} ---"
            row_cells[1].paragraphs[0].runs[0].bold = True
            row_cells[1].merge(row_cells[5])
            row_num += 1

            # Услуги в категории
            for service in services:
                row_cells = table.add_row().cells
                row_cells[0].text = str(row_num)
                row_cells[1].text = service['service']
                row_cells[2].text = service['unit']
                row_cells[3].text = str(service['quantity'])
                row_cells[4].text = str(service['price'])
                row_cells[5].text = f"{service['total']:.2f}"
                row_num += 1
                total_sum += service['total']

        # Итоговая строка
        row_cells = table.add_row().cells
        row_cells[0].text = ""
        row_cells[1].text = "ВСЕГО:"
        row_cells[1].paragraphs[0].runs[0].bold = True
        row_cells[1].merge(row_cells[4])
        row_cells[5].text = f"{total_sum:.2f}"
        row_cells[5].paragraphs[0].runs[0].bold = True

        # Дополнительная информация
        doc.add_paragraph("")
        doc.add_paragraph("Примечания:")
        doc.add_paragraph("1. В стоимость работ включены материалы, указанные в смете.")
        doc.add_paragraph("2. Срок выполнения работ согласовывается дополнительно.")
        doc.add_paragraph("3. Цены указаны в рублях")
        doc.add_paragraph("4. Смета действительна в течение 30 дней с даты составления.")
        doc.add_paragraph("")

        # Подписи
        p = doc.add_paragraph()
        p.add_run("Исполнитель: _________________").bold = True
        p.add_run(" " * 30)
        p.add_run("Заказчик: _________________").bold = True

        doc.add_paragraph("")
        p = doc.add_paragraph()
        p.add_run("Дата: _________________")

        # Сохраняем документ
        doc.save(file_path)

        messagebox.showinfo("Успех", f"Смета успешно создана!\nФайл сохранен: {file_path}")

        # Предложим открыть файл
        if messagebox.askyesno("Открыть файл", "Открыть созданный файл сметы?"):
            os.startfile(file_path)

    except Exception as e:
        messagebox.showerror("Ошибка", f"Не удалось создать документ:\n{str(e)}")


def ask_project_info():
    """Спросить информацию о проекте"""
    global project_name, customer_name, project_address

    # Создаем окно для ввода информации
    info_window = tk.Toplevel(root)
    info_window.title("Информация о проекте")
    info_window.geometry("500x300")
    info_window.resizable(False, False)
    info_window.configure(bg=BG_COLOR)
    info_window.transient(root)
    info_window.grab_set()

    # Центрируем окно
    info_window.update_idletasks()
    x = root.winfo_x() + (root.winfo_width() - info_window.winfo_width()) // 2
    y = root.winfo_y() + (root.winfo_height() - info_window.winfo_height()) // 2
    info_window.geometry(f"+{x}+{y}")

    # Заголовок
    tk.Label(info_window, text="Введите информацию о проекте",
             font=('Arial', 14, 'bold'), fg='white', bg=BG_COLOR).pack(pady=(20, 20))

    # Фрейм для полей ввода
    input_frame = tk.Frame(info_window, bg=BG_COLOR)
    input_frame.pack(padx=20, pady=10)

    # Название проекта
    tk.Label(input_frame, text="Название проекта:",
             font=('Arial', 10), fg='white', bg=BG_COLOR, anchor='w').grid(row=0, column=0, sticky='w', pady=5)
    project_entry = tk.Entry(input_frame, font=('Arial', 10), width=40)
    project_entry.grid(row=0, column=1, padx=(10, 0), pady=5)
    project_entry.insert(0, project_name)

    # Заказчик
    tk.Label(input_frame, text="Заказчик:",
             font=('Arial', 10), fg='white', bg=BG_COLOR, anchor='w').grid(row=1, column=0, sticky='w', pady=5)
    customer_entry = tk.Entry(input_frame, font=('Arial', 10), width=40)
    customer_entry.grid(row=1, column=1, padx=(10, 0), pady=5)
    customer_entry.insert(0, customer_name)

    # Адрес
    tk.Label(input_frame, text="Адрес объекта:",
             font=('Arial', 10), fg='white', bg=BG_COLOR, anchor='w').grid(row=2, column=0, sticky='w', pady=5)
    address_entry = tk.Entry(input_frame, font=('Arial', 10), width=40)
    address_entry.grid(row=2, column=1, padx=(10, 0), pady=5)
    address_entry.insert(0, project_address)

    # Функция сохранения
    def save_info():
        global project_name, customer_name, project_address
        project_name = project_entry.get().strip()
        customer_name = customer_entry.get().strip()
        project_address = address_entry.get().strip()

        if not project_name:
            messagebox.showwarning("Внимание", "Введите название проекта!")
            return

        info_window.destroy()

    # Фрейм для кнопок
    button_frame = tk.Frame(info_window, bg=BG_COLOR)
    button_frame.pack(pady=20)

    # Кнопка сохранить
    tk.Button(button_frame, text="Сохранить и создать смету",
              command=save_info,
              font=('Arial', 10, 'bold'), bg=ACCENT_COLOR, fg='white',
              padx=20, pady=5).pack(side='left', padx=(0, 10))

    # Кнопка отмены
    tk.Button(button_frame, text="Отмена",
              command=info_window.destroy,
              font=('Arial', 10), bg='#444444', fg='white',
              padx=20, pady=5).pack(side='left')

    # Фокус на первом поле
    project_entry.focus_set()

    # Ожидаем закрытия окна
    info_window.wait_window()


