def clear_all_entries():
    """Очистить все поля ввода во всех вкладках"""
    for tab_name in calculator_entries:
        for entry in calculator_entries[tab_name]:
            entry.delete(0, tk.END)
            entry.insert(0, "0")

    # Обнуляем все метки стоимости
    for tab_name in cost_labels:
        for label in cost_labels[tab_name]:
            label.config(text="0.00")

    calculate_global_total()


def update_row_cost(quantity_var, cost_label, price):
    """Обновить стоимость строки и общую стоимость"""
    try:
        qty = float(quantity_var.get()) if quantity_var.get().strip() else 0
        if qty >= 0:
            row_total = qty * price
            cost_label.config(text=f"{row_total:.2f}")
        else:
            cost_label.config(text="0.00")
    except ValueError:
        cost_label.config(text="0.00")

    # Пересчитываем общую стоимость
    calculate_global_total()


def toggle_tab(tab_name):
    """Переключение вкладки"""
    content_frame = tab_content_widgets[tab_name]

    if tab_states[tab_name]:
        # Закрыть вкладку
        content_frame.pack_forget()
        tab_states[tab_name] = False
        display_name = tab_name[:30] + '...' if len(tab_name) > 30 else tab_name
        tab_buttons[tab_name].config(text=f'▶ {display_name}')
    else:
        # Закрыть все остальные вкладки
        for name in tabs_content.keys():
            if name != tab_name and tab_states[name]:
                tab_content_widgets[name].pack_forget()
                tab_states[name] = False
                display_name = name[:30] + '...' if len(name) > 30 else name
                tab_buttons[name].config(text=f'▶ {display_name}')

        # Открыть выбранную вкладку
        content_frame.pack(fill='both', expand=True, padx=(10, 0), pady=(0, 0))
        tab_states[tab_name] = True
        display_name = tab_name[:30] + '...' if len(tab_name) > 30 else tab_name
        tab_buttons[tab_name].config(text=f'▼ {display_name}')


