# Функции для работы с калькулятором
def calculate_global_total():
    """Рассчитать общую стоимость по всем вкладкам"""
    global total_cost_global, selected_services

    total_cost_global = 0.0
    selected_services = []

    # Проходим по всем вкладкам
    for tab_name in calculator_data.keys():
        if tab_name in calculator_entries:
            entries_list = calculator_entries[tab_name]

            for i, entry in enumerate(entries_list):
                if i < len(calculator_data[tab_name]):
                    service, unit, price = calculator_data[tab_name][i]
                    quantity_text = entry.get()
                    if quantity_text.strip():
                        try:
                            quantity = float(quantity_text)
                            if quantity > 0:
                                service_total = quantity * price
                                total_cost_global += service_total

                                # Добавляем услугу в список для детализации
                                selected_services.append({
                                    'tab': tab_name,
                                    'service': service,
                                    'unit': unit,
                                    'price': price,
                                    'quantity': quantity,
                                    'total': service_total
                                })
                        except ValueError:
                            pass

    # Обновляем отображение общей стоимости
    if total_cost_label:
        total_cost_label.config(text=f"ИТОГО ПО ВСЕМ КАТЕГОРИЯМ: {total_cost_global:.2f} руб.")

    # Обновляем детализацию
    update_selected_services()


def update_selected_services():
    """Обновить список выбранных услуг"""
    if not selected_services_frame:
        return

    # Очищаем фрейм
    for widget in selected_services_frame.winfo_children():
        widget.destroy()

    # Добавляем заголовок
    if selected_services:
        tk.Label(selected_services_frame, text="Выбранные услуги:",
                 font=('Arial', 10, 'bold'), fg=ACCENT_COLOR, bg=BG_COLOR,
                 anchor='w').pack(fill='x', pady=(0, 5))

        # Ограничиваем количество отображаемых услуг
        max_display = 10
        services_to_display = selected_services[:max_display]

        for item in services_to_display:
            service_text = f"{item['service']} - {item['quantity']} {item['unit']} × {item['price']} руб. = {item['total']:.2f} руб."
            tk.Label(selected_services_frame, text=service_text,
