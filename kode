    # Изначально скрываем все вкладки кроме первой
    if i != 0:
        content_frame.pack_forget()

    tab_content_widgets[tab_name] = content_frame

# Открываем первую вкладку по умолчанию
if tabs_content:
    first_tab = list(tabs_content.keys())[0]
    tab_states[first_tab] = True
    display_name = first_tab[:30] + '...' if len(first_tab) > 30 else first_tab
    tab_buttons[first_tab].config(text=f'▼ {display_name}')


# Добавляем прокрутку колесиком мыши
def on_mousewheel(event):
    tab_canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")


tab_canvas.bind_all("<MouseWheel>", on_mousewheel)

# Информация о программе внизу
info_frame = tk.Frame(main_frame, bg=BG_COLOR)
info_frame.pack(side='bottom', fill='x', pady=(10, 0))

info_text = "Введите количество в желтые поля. Расчет общей стоимости происходит автоматически."
if HAS_DOCX:
    info_text += " Нажмите 'Создать смету в Word' для экспорта."

tk.Label(info_frame,
         text=info_text,
         font=('Arial', 9),
         fg='#cccccc',
         bg=BG_COLOR).pack()

# Инициализируем отображение выбранных услуг
update_selected_services()

# Запуск приложения
root.mainloop()
